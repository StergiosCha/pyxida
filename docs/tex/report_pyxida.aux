\@writefile{toc}{\contentsline {section}{\numberline {2}Τα ποσοστά κενών θέσεων καθορίζονται από τη ζήτηση, όχι από τα προβλήματα στέγασης}{2}{section.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Ζήτηση ανά χωρητικότητα (Μέγιστη προτίμηση/λογάριθμος χωρητικότητας) έναντι κενών θέσεων, ΓΕΛ90 2025 ($n=453$). Αρνητική συσχέτιση $r=-0{,}47$· μερική συσχέτιση που ελέγχει για τη μεταβλητή αναφοράς $-0{,}35$. {\footnotesize  \color  {srcgray}[\textit  {πηγή:} University Compass Database, endpoint \texttt  {/stats/demand}]}}}{2}{figure.caption.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3}Πεδία εισαγωγής για μη εθνικά πανεπιστήμια}{2}{section.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Σύγκριση του μέσου ποσοστού κενών θέσεων στον δημόσιο τομέα για κάθε πρόγραμμα ΝΠΠΕ με τον εθνικό μέσο όρο (17\%). Χαμηλότερη τιμή = ισχυρότερη δημόσια ζήτηση. {\footnotesize  \color  {srcgray}[\textit  {πηγή:} University Compass Database, endpoint \texttt  {/nppe/intent}]}}}{3}{figure.caption.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4}Το δημοσιονομικό αποτύπωμα της περιφερειακής απαξίωσης}{3}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5}Αρνητικό αποτέλεσμα: ο πλούτος δεν εξηγεί την πληρότητα}{3}{section.5}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {6}Πρόβλεψη βάσεων: το μηχανιστικό μοντέλο ΕΒΕ κερδίζει το benchmark}{4}{section.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Σύγκριση σφάλματος (ΜΑΕ) πέντε μοντέλων, backtest 2024$\to $2025. Η διακεκομμένη γραμμή είναι το carry-forward benchmark. Μόνο το μηχανιστικό μοντέλο ΕΒΕ νικά και στους δύο στόχους.}}{4}{figure.caption.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Μοντέλο συστάδας για τις Φιλοσοφικές Σχολές: 27\% βελτίωση ΜΑΕ έναντι carry-forward, με περιορισμό των υπερβολών του ανεξάρτητου μοντέλου.}}{5}{figure.caption.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Γεωγραφική υποκατάσταση: η πίεση σε ένα τμήμα ρέει στα κοντινά ηπειρωτικά τμήματα (π.χ. Θεσσαλονίκη$\to $Ιωάννινα, 208 km ξηρά), όχι στην Κρήτη (601 km + θάλασσα + ακριβότερο ενοίκιο).}}{5}{figure.caption.6}\protected@file@percent }
